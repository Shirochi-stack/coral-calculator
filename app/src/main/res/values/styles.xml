<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CoralCalculator" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#FF393F</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FAFAFA</item>
        <item name="android:navigationBarColor">#FAFAFA</item>
        <item name="android:windowBackground">#FAFAFA</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!-- The companion's settings when the calculator is set to its dark appearance. -->
    <style name="Theme.CoralCalculator.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#FF393F</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#17191B</item>
        <item name="android:navigationBarColor">#17191B</item>
        <item name="android:windowBackground">#17191B</item>
    </style>
</resources>
